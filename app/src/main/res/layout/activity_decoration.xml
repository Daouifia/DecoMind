<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_room"
            style="@style/DecoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <TextView
            style="@style/DecoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_style" />

        <RadioGroup
            android:id="@+id/rg_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_modern"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_modern" />

            <RadioButton
                android:id="@+id/rb_classic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_classic" />

            <RadioButton
                android:id="@+id/rb_minimalist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_minimalist" />

            <RadioButton
                android:id="@+id/rb_bohemian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_bohemian" />
        </RadioGroup>

        <TextView
            style="@style/DecoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_palette" />

        <Spinner
            android:id="@+id/sp_palette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/DecoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_colors" />

        <LinearLayout
            android:id="@+id/ll_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/DecoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_preview" />

        <LinearLayout
            android:id="@+id/ll_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save"
                style="@style/DecoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_save" />

            <Button
                android:id="@+id/btn_cancel"
                style="@style/DecoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>