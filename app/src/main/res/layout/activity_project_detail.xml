<?xml version="1.0" encoding="utf-8"?>
<!--
  Projet : DecoMind
  Fichier : activity_project_detail.xml
  Description : Interface graphique de la fiche d'un projet (liste des pièces et actions)
  Responsable(s) :
  - Lahroum Amina
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_description"
            style="@style/DecoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_reminder"
            style="@style/DecoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_description" />

        <TextView
            android:id="@+id/tv_rooms_title"
            style="@style/DecoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/label_rooms"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reminder" />

        <ListView
            android:id="@+id/list_rooms"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:nestedScrollingEnabled="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_rooms_title" />

        <TextView
            android:id="@+id/tv_room_info"
            style="@style/DecoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/list_rooms" />

        <Button
            android:id="@+id/btn_add_room"
            style="@style/DecoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_add_room"
            app:layout_constraintEnd_toStartOf="@id/btn_edit_room"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_room_info" />

        <Button
            android:id="@+id/btn_edit_room"
            style="@style/DecoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_edit_room"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_add_room"
            app:layout_constraintTop_toBottomOf="@id/tv_room_info" />

        <Button
            android:id="@+id/btn_delete_room"
            style="@style/DecoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_delete_room"
            app:layout_constraintEnd_toStartOf="@id/btn_furniture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_add_room" />

        <Button
            android:id="@+id/btn_furniture"
            style="@style/DecoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_furniture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_delete_room"
            app:layout_constraintTop_toBottomOf="@id/btn_edit_room" />

        <Button
            android:id="@+id/btn_decoration"
            style="@style/DecoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_decoration"
            app:layout_constraintEnd_toStartOf="@id/btn_budget"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_delete_room" />

        <Button
            android:id="@+id/btn_budget"
            style="@style/DecoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_budget"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_decoration"
            app:layout_constraintTop_toBottomOf="@id/btn_furniture" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>