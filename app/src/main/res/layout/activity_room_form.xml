<?xml version="1.0" encoding="utf-8"?>
<!--
  Projet : DecoMind
  Fichier : activity_room_form.xml
  Description : Interface graphique du formulaire de création et de modification d'une pièce
  Responsable(s) :
  - Lahroum Amina
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_card">

            <ImageView
                android:id="@+id/iv_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/btn_add_photo"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_image" />

            <Button
                android:id="@+id/btn_add_photo"
                style="@style/DecoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="@string/btn_add_photo" />
        </FrameLayout>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stretchColumns="1">

            <TableRow>

                <TextView
                    style="@style/DecoLabel"
                    android:text="@string/label_room_type" />

                <Spinner
                    android:id="@+id/sp_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </TableRow>

            <TableRow>

                <TextView
                    style="@style/DecoLabel"
                    android:text="@string/label_room_name" />

                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_room_name"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />
            </TableRow>

            <TableRow>

                <TextView
                    style="@style/DecoLabel"
                    android:text="@string/label_length" />

                <EditText
                    android:id="@+id/et_length"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />
            </TableRow>

            <TableRow>

                <TextView
                    style="@style/DecoLabel"
                    android:text="@string/label_width" />

                <EditText
                    android:id="@+id/et_width"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />
            </TableRow>

            <TableRow>

                <TextView
                    style="@style/DecoLabel"
                    android:text="@string/label_height" />

                <EditText
                    android:id="@+id/et_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/tv_area"
            style="@style/DecoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save"
                style="@style/DecoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_save" />

            <Button
                android:id="@+id/btn_cancel"
                style="@style/DecoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>